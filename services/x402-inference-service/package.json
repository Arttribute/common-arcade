{
  "name": "@common-arcade/x402-inference-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsup src/app.ts src/server.ts --format esm --dts --clean",
    "clean": "rm -rf dist coverage",
    "dev": "tsx watch src/server.ts",
    "lint": "tsc --noEmit --pretty false",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@x402/core": "^2.25.0",
    "@x402/hedera": "^2.25.0",
    "@x402/hono": "^2.25.0",
    "hono": "^4.13.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
