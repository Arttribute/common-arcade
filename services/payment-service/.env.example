PORT=4021
ARCADE_PAYMENT_DOMAIN=http://localhost:4021
ARCADE_PAYMENT_ORIGINS=http://localhost:3000
ARCADE_PAYMENT_DATA_DIR=./.payment-data
# Free mode works without wallets or contracts configured on the server.
ARCADE_ESCROW_DEPLOYMENTS={}
ARCADE_X402_RAILS=[]
# Comma-separated EOA creators for the paid testnet preview; empty denies paid creation.
ARCADE_PAYMENT_CREATORS=
# Set resolver keys through secret injection only. Never commit a populated .env.
# ARCADE_RESOLVER_KEY_84532=
# ARCADE_RESOLVER_KEY_5042002=
# ARCADE_RESOLVER_KEY_296=
# Optional private Arc/Base facilitator (separate process; not publicly exposed).
# ARCADE_FACILITATOR_NETWORK=arc-testnet
# ARCADE_FACILITATOR_PRIVATE_KEY=
# ARCADE_FACILITATOR_RPC_URL=https://rpc.testnet.arc.io
# ARCADE_FACILITATOR_HOST=127.0.0.1
