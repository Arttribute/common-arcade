{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://arcade.agentcommons.io/schemas/v0alpha1/match.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "eventSequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "pattern": "^mat_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "type": "string"
    },
    "mode": {
      "enum": ["turn-based", "simultaneous", "realtime", "hybrid"],
      "type": "string"
    },
    "ownershipEpoch": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "releaseDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "releaseId": {
      "pattern": "^rel_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/__schema0"
    },
    "seats": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "actorId": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^sea_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": ["open", "claimed", "connected", "disconnected"],
            "type": "string"
          },
          "team": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["id", "role", "status"],
        "type": "object"
      },
      "type": "array"
    },
    "stateSequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "enum": [
        "created",
        "lobby",
        "ready",
        "checking",
        "starting",
        "running",
        "paused",
        "finishing",
        "completed",
        "canceled",
        "expired",
        "failed",
        "invalidated"
      ],
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    }
  },
  "required": [
    "id",
    "releaseId",
    "releaseDigest",
    "mode",
    "status",
    "ownershipEpoch",
    "stateSequence",
    "eventSequence",
    "createdAt",
    "updatedAt",
    "seats"
  ],
  "title": "Common Arcade match",
  "type": "object"
}
