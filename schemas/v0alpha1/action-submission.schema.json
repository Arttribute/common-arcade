{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://arcade.agentcommons.io/schemas/v0alpha1/action-submission.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actionId": {
      "pattern": "^act_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "type": "string"
    },
    "basedOnStateSequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "clientSequence": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "controlLease": {
      "maxLength": 4096,
      "minLength": 16,
      "type": "string"
    },
    "matchId": {
      "pattern": "^mat_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/__schema0"
    },
    "policyExecutionId": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "seatId": {
      "pattern": "^sea_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "type": "string"
    },
    "targetTick": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "targetTurn": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "trace": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "actionId",
    "matchId",
    "seatId",
    "controlLease",
    "clientSequence",
    "basedOnStateSequence",
    "payload"
  ],
  "title": "Common Arcade action-submission",
  "type": "object"
}
