{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://arcade.agentcommons.io/schemas/v0alpha1/event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "audienceId": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "pattern": "^evt_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "type": "string"
    },
    "matchId": {
      "pattern": "^mat_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/__schema0"
    },
    "sequence": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "tick": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "turn": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "type": {
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$",
      "type": "string"
    },
    "visibility": {
      "enum": ["public", "team", "seat", "referee"],
      "type": "string"
    }
  },
  "required": [
    "id",
    "matchId",
    "sequence",
    "type",
    "visibility",
    "at",
    "payload"
  ],
  "title": "Common Arcade event",
  "type": "object"
}
