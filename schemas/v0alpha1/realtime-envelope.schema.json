{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://arcade.agentcommons.io/schemas/v0alpha1/realtime-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "match": {
      "pattern": "^mat_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/__schema0"
    },
    "sentAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "seq": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "session": {
      "pattern": "^ses_[A-Za-z0-9][A-Za-z0-9_-]{7,127}$",
      "type": "string"
    },
    "tick": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "trace": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "enum": [
        "hello",
        "resume",
        "action.submit",
        "ack",
        "ping",
        "pong",
        "flow.preference",
        "session.close",
        "welcome",
        "snapshot",
        "observation.full",
        "observation.delta",
        "action.result",
        "event.batch",
        "clock.sync",
        "control.granted",
        "control.revoked",
        "match.transition",
        "flow.notice",
        "resync.required",
        "error",
        "goodbye"
      ],
      "type": "string"
    },
    "v": {
      "const": "v0alpha1",
      "type": "string"
    }
  },
  "required": ["v", "type", "seq", "sentAt", "payload"],
  "title": "Common Arcade realtime-envelope",
  "type": "object"
}
