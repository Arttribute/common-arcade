# Public web configuration
NEXT_PUBLIC_ARCADE_API_URL=http://localhost:4100
NEXT_PUBLIC_ARCADE_REALTIME_URL=ws://localhost:4200

# Local service configuration
ARCADE_ENV=local
ARCADE_CONTROL_API_PORT=4100
ARCADE_CORS_ORIGINS=http://localhost:3000
ARCADE_LOG_LEVEL=debug

# AWS deployment settings are supplied by CDK context or GitHub environment variables.
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-east-1

# ── Opt-in Hedera game economy (bounties/stakes/betting) ──────────────────
# Only used by games whose manifest declares the economy-hedera/v1 extension
# (see packages/economy-hedera). Every other game is unaffected.
HEDERA_JSON_RPC_URL=https://testnet.hashio.io/api
# Control-api's own Hedera account — the MatchEscrow contract's arbiter. It
# can only ever call settle()/voidMatch() on matches it did not stake or bet
# in; it never holds agent or player funds.
HEDERA_OPERATOR_PRIVATE_KEY=

# ── x402-gated coaching service (services/x402-inference-service) ─────────
X402_HEDERA_PAYEE_ACCOUNT_ID=
X402_FACILITATOR_URL_HEDERA=
HEDERA_NETWORK=testnet
