# Public web configuration
NEXT_PUBLIC_ARCADE_API_URL=http://localhost:4100
NEXT_PUBLIC_ARCADE_REALTIME_URL=ws://localhost:4200
# Base URL of the Agent Commons payments service, used by the agent wallet panel.
NEXT_PUBLIC_ARCADE_PAYMENTS_URL=

# Local service configuration
ARCADE_ENV=local
ARCADE_CONTROL_API_PORT=4100
ARCADE_CORS_ORIGINS=http://localhost:3000
ARCADE_LOG_LEVEL=debug
# Base URL the arcade control API uses to reach Agent Commons.
AGENT_COMMONS_API_URL=

# "Continue with Commons" sign-in (apps/web/app/api/auth/*). Without
# COMMONS_IDENTITY_CLIENT_ID set, /api/auth/login returns
# {"error":"Commons sign-in is not configured."} and sign-in is disabled.
# Get a client id/secret by registering an OAuth app with Agent Commons identity.
COMMONS_IDENTITY_CLIENT_ID=
COMMONS_IDENTITY_CLIENT_SECRET=
# Defaults to https://auth.agentcommons.io/api/auth if unset.
COMMONS_IDENTITY_ISSUER=
# Defaults to "commons-platform" if unset.
COMMONS_IDENTITY_AUDIENCE=
# Origin the OAuth callback must land on (e.g. http://localhost:3000).
# Defaults to the incoming request's origin if unset.
ARCADE_WEB_URL=
# Encrypts the signed-in session cookie. Required, must be 32+ characters.
# Generate one locally with: openssl rand -base64 32
ARCADE_SESSION_SECRET=

# Alternative to COMMONS_IDENTITY_CLIENT_ID/SECRET: if those aren't set,
# /api/auth/login will instead sign you in using this pre-issued Arcade
# access token (verified against COMMONS_IDENTITY_ISSUER's userinfo endpoint) —
# no OAuth client id/secret needed. Get a token from wherever you already have
# one (e.g. a signed-in session on the deployed app).
ARCADE_DEV_ACCESS_TOKEN=

# AWS deployment settings are supplied by CDK context or GitHub environment variables.
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-east-1
