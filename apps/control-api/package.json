{
  "name": "@common-arcade/control-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsup src/app.ts src/server.ts src/lambda.ts --format esm --dts --clean",
    "clean": "rm -rf dist coverage",
    "dev": "tsx watch src/server.ts",
    "lint": "tsc --noEmit --pretty false",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.883.0",
    "@aws-sdk/client-lambda": "^3.883.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.883.0",
    "@aws-sdk/s3-presigned-post": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@common-arcade/auth": "workspace:^",
    "@common-arcade/diagnostics": "workspace:^",
    "@common-arcade/economy": "workspace:^",
    "@common-arcade/example-tic-tac-toe": "workspace:^",
    "@common-arcade/manifest": "workspace:^",
    "@common-arcade/match-worker-service": "workspace:^",
    "@common-arcade/protocol": "workspace:^",
    "@common-arcade/studio": "workspace:^",
    "@common-arcade/test-arena": "workspace:^",
    "@hono/node-server": "^2.1.1",
    "@privy-io/node": "0.34.0",
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "hono": "^4.13.5",
    "jose": "^6.1.0",
    "viem": "2.56.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
