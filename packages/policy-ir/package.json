    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@common-arcade/protocol": "workspace:^",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
